{
  "name": "@fistware/sample-log-redaction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable demo of @fistware/logger redaction and @fistware/http-client log sanitization.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "demo": "node --loader ts-node/esm src/demo.ts",

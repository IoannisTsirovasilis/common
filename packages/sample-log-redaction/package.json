  },
  "dependencies": {
    "@fistware/http-client": "file:../http-client",
    "@fistware/logger": "file:../logger",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@fistware/lint-ts": "2.0.0",
    "@types/node": "24.12.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
